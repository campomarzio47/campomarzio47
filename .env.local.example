# Copia questo file in .env.local (in locale). In produzione le stesse
# variabili si impostano sulla piattaforma, non in un file:
#   - Cloudflare: le NEXT_PUBLIC_* nelle build variables (Worker → Settings
#     → Builds), tutte le altre in Settings → Variables and Secrets, come
#     Secret le password e gli URL iCal. Vedi TEMPLATE-SETUP.md §5.
#   - Vercel (Campo Marzio 47): Settings → Environment Variables.
#
# Su Cloudflare non pubblicare MAI dal PC con questo file compilato:
# l'adapter OpenNext copierebbe i valori dentro il Worker. Il deploy passa
# da GitHub (Workers Builds); `npm run deploy` lo impedisce di suo.

# Server SMTP usato per inviare le email del sito (check-in, contatti,
# richieste di prenotazione).
#
# IMPORTANTE, e non è un dettaglio tecnico: il sito invia dati personali,
# compresi gli estremi di un documento d'identità. Chi tratta quei dati per
# tuo conto dev'essere un fornitore con cui hai un accordo ai sensi
# dell'art. 28 GDPR. Un account Gmail gratuito NON ce l'ha: è pensato per
# uso personale. Usa un servizio transazionale con DPA incluso anche nel
# piano gratuito — Brevo (smtp-relay.brevo.com) o Mailjet
# (in-v3.mailjet.com), entrambi europei — oppure la casella SMTP del tuo
# dominio. Vedi LEGALE.md.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Mittente delle email inviate dal sito. Deve essere un indirizzo che il
# provider SMTP qui sopra ti autorizza a usare, altrimenti le email
# vengono rifiutate o finiscono in spam.
MAIL_FROM=

# Indirizzo a cui ARRIVANO le email di check-in, contatto e prenotazione.
# Stesso discorso dell'SMTP: se è una casella Gmail personale, Google
# tratta quei dati per te senza accordo art. 28. Una casella sul tuo
# dominio costa pochi euro l'anno ed è il modo più semplice per chiudere
# il punto. Vedi LEGALE.md.
HOST_EMAIL=

# Facoltativi: link "Esporta calendario" (iCal) dal pannello host di Airbnb e
# Booking.com. Se assenti, il calendario di /prenota e la barra "Verifica
# disponibilità" in home funzionano comunque, ma senza disabilitare le date
# già occupate su Airbnb/Booking.
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=

# Codice struttura assegnato dall'ente regionale per la movimentazione
# turistica (Ross1000/GIES). Senza questo valore il campo <codice> dell'XML
# resta "DA_CONFIGURARE" e va corretto a mano prima del caricamento.
ROSS1000_CODICE_STRUTTURA=

# Facoltativi: nome del "prodotto" (software/sito) e numero di letti
# disponibili della struttura, usati nell'XML. Se assenti, il sito usa
# rispettivamente "<NomeProprieta>Website" (derivato da content/property.ts)
# e il numero massimo di ospiti impostato in facts.maxGuests.
ROSS1000_PRODOTTO=
ROSS1000_LETTI_DISPONIBILI=

# Facoltativo: se impostata, i tre allegati del check-in non viaggiano più
# come file separati ma dentro un unico ZIP cifrato con AES-256, protetto
# da questa password. Serve a non lasciare in chiaro, nella casella di
# posta, il numero di documento degli ospiti.
#
# Lasciala vuota se preferisci la comodità: lo ZIP AES-256 non si apre col
# doppio clic di Esplora file di Windows, richiede 7-Zip. La password non
# viene MAI scritta nell'email: la devi conoscere già tu.
CHECKIN_ZIP_PASSWORD=

# URL pubblico del sito (senza slash finale), usato per SEO: sitemap.xml,
# robots.txt, tag canonical/Open Graph. Impostare al dominio reale prima
# del lancio (es. https://tuosito.it). È letta alla BUILD: cambiarla senza
# un nuovo deploy non ha effetto.
# Deve combaciare ESATTAMENTE con l'indirizzo che risponde 200, incluso
# l'eventuale www: se qui c'e' l'apex ma l'apex viene rediretto al www
# (o viceversa), il canonical punta a un URL che rimbalza e Google lo
# ignora. Lo stesso indirizzo va tenuto in CANONICAL_HOST dentro
# next.config.ts, che da li' costruisce i redirect dagli indirizzi in
# ALIAS_HOSTS (sottodominio .workers.dev o .vercel.app, www).
NEXT_PUBLIC_SITE_URL=

# Facoltativo: codice di verifica della proprietà in Google Search Console.
# In Search Console scegli la proprietà "Prefisso URL" -> metodo "Tag HTML":
# ti mostra <meta name="google-site-verification" content="ABC123..." />.
# Qui va SOLO il valore di content (ABC123...), non il tag intero.
# Impostalo sulla piattaforma (build variable su Cloudflare, ambiente
# Production su Vercel), fai il deploy e poi premi
# "Verifica". Può restare impostato per sempre: serve anche a mantenere
# la verifica nel tempo.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Nessuna variabile per Google Analytics, di proposito. GA scrive cookie di
# terze parti e in Italia richiede un consenso preventivo: rimetterlo
# significherebbe aggiungere un banner che lo blocca finché l'utente non
# accetta, e riscrivere la cookie policy. Se servono le statistiche, meglio
# uno strumento che non scrive cookie e non profila.
