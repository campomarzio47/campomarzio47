# Copia questo file in .env.local (in locale) e imposta le stesse variabili
# nelle Environment Variables del progetto su Vercel per il deploy.

# Account Gmail usato per inviare le email dal sito (check-in e contatti).
# GMAIL_APP_PASSWORD non è la password normale di Gmail: va generata da
# https://myaccount.google.com/apppasswords (richiede la verifica in due passaggi attiva).
GMAIL_USER=tuoaccount@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Indirizzo a cui arrivano le email di check-in e contatto.
HOST_EMAIL=tuoaccount@gmail.com

# Facoltativi: link "Esporta calendario" (iCal) dal pannello host di Airbnb e
# Booking.com. Se assenti, il calendario di /prenota e la barra "Verifica
# disponibilità" in home funzionano comunque, ma senza disabilitare le date
# già occupate su Airbnb/Booking.
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=

# Codice struttura assegnato dall'ente regionale per la movimentazione
# turistica (Ross1000/GIES). Senza questo valore il campo <codice> dell'XML
# resta "DA_CONFIGURARE" e va corretto a mano prima del caricamento.
ROSS1000_CODICE_STRUTTURA=

# Facoltativi: nome del "prodotto" (software/sito) e numero di letti
# disponibili della struttura, usati nell'XML. Se assenti, il sito usa
# rispettivamente "<NomeProprieta>Website" (derivato da content/property.ts)
# e il numero massimo di ospiti impostato in facts.maxGuests.
ROSS1000_PRODOTTO=
ROSS1000_LETTI_DISPONIBILI=

# Prenotazione diretta con pagamento (Stripe). Chiave segreta e webhook
# secret dalla Dashboard Stripe (https://dashboard.stripe.com/apikeys e
# https://dashboard.stripe.com/webhooks). In locale, usare le chiavi di
# test (sk_test_...) e "stripe listen --forward-to
# localhost:3000/api/stripe/webhook" per ottenere il webhook secret locale.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Secret usato per firmare (HMAC) i link di conferma/rifiuto prenotazione
# inviati via email all'host. Generarlo una volta con:
#   openssl rand -hex 32
# e non cambiarlo dopo (invaliderebbe i link già inviati).
BOOKING_TOKEN_SECRET=
